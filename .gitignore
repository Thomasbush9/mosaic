# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
tags/
tags
tag/*
tag/
__marimo__/
# Virtual environments
.venv

.envrc

# SLURM job output from singularity/*.sbatch
logs/

# uv.lock is deliberately tracked on this fork (upstream ignores it). Nine
# dependencies are git-sourced, so without a lock every container build
# re-resolves them at HEAD and images are not reproducible.
# See singularity/mosaic.def.
# webapp virtualenv (created on first run by webapp/connect.sh)
webapp/.venv/
webapp/streamlit.log

# Editor swap files. These have twice been picked up by `git add -A` while a
# file was open in vim.
*.swp
*.swo

# Lustre leaves byte-identical copies of a file next to it with an OST-error
# suffix when a stripe is briefly unreadable (e.g.
# src/mosaic/alphafold/model/utils.py.ost000a-unreadable). They are not edits
# and must never be committed -- same reason as the *.swp entries above.
*.ost*-unreadable
