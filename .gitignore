# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

.envrc

# SLURM job output from singularity/*.sbatch
logs/

# uv.lock is deliberately tracked on this fork (upstream ignores it). Nine
# dependencies are git-sourced, so without a lock every container build
# re-resolves them at HEAD and images are not reproducible.
# See singularity/mosaic.def.
# webapp virtualenv (created on first run by webapp/connect.sh)
webapp/.venv/
webapp/streamlit.log
