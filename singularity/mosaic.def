Bootstrap: docker
From: ubuntu:24.04

# ─────────────────────────────────────────────────────────────────────────────
# mosaic — single-GPU JAX protein design, packaged for SLURM + Singularity.
#
# Design notes (the non-obvious choices, so review is quick):
#
#   * Base is plain Ubuntu, NOT nvidia/cuda. `jax[cuda12]` ships its own CUDA
#     libraries as pip wheels, and `singularity exec --nv` injects the host
#     driver. A CUDA base image would duplicate ~3 GB for nothing.
#
#   * Pin `jax[cuda12]`, not `jax[cuda]` / `jax[cuda13]`. The cluster driver
#     reports CUDA ≤12.9.1; CUDA-13 wheels need driver ≥580 and will fail here.
#
#   * 24.04 ships Python 3.12 natively, which is what pyproject.toml pins
#     (`requires-python = "==3.12.*"`). No deadsnakes PPA, no uv-managed
#     interpreter.
#
#   * torch is pinned to the CPU wheel index upstream and is only used to load
#     checkpoints before conversion to Equinox/JAX. It never touches the GPU,
#     so nothing here needs a GPU-enabled torch.
#
#   * wget is a hard runtime dependency, not a convenience: models/boltzgen.py
#     shells out to the binary to fetch checkpoints. Without it you get a
#     zero-byte file and an opaque unpickling error much later.
#
#   * libxrender1 / libxext6 / libsm6 are needed by rdkit.Chem.Draw, which
#     pdbeccdutils imports at module scope, which jopenfold3 imports during
#     featurization. Nothing here draws anything — but without them OF3 fails at
#     import with `libXrender.so.1: cannot open shared object file`.
#
#   * build-essential is needed at build time even though nothing here is
#     compiled on purpose: opendde pulls in scikit-learn-extra 0.3.0, which
#     publishes no cp312 wheel, so uv compiles it from the sdist. It is left
#     installed rather than purged — ~200 MB against multi-GB CUDA wheels.
#
#   * NO model weights are baked in. They live on shared storage and are bound
#     at runtime — see singularity/README.md for the layout and why.
# ─────────────────────────────────────────────────────────────────────────────

%labels
    Maintainer   Thomas Bush
    Upstream     https://github.com/escalante-bio/mosaic
    Purpose      Multi-objective protein design (JAX), one GPU per job
    JAXBackend   cuda12

%files
    # Copy the working tree explicitly rather than `. /opt/mosaic` so the
    # 70 MB .git directory and any local .venv stay out of the image.
    pyproject.toml   /opt/mosaic/pyproject.toml
    uv.lock          /opt/mosaic/uv.lock
    run_design.py    /opt/mosaic/run_design.py
    README.md        /opt/mosaic/README.md
    stability.eqx    /opt/mosaic/stability.eqx
    src              /opt/mosaic/src
    examples         /opt/mosaic/examples
    singularity      /opt/mosaic/singularity

%post
    set -eux
    export DEBIAN_FRONTEND=noninteractive

    apt-get update
    apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        wget \
        build-essential \
        python3.12 \
        python3.12-venv \
        python3.12-dev \
        libgomp1 \
        libxrender1 \
        libxext6 \
        libsm6
    rm -rf /var/lib/apt/lists/*

    # ── uv ───────────────────────────────────────────────────────────────────
    export UV_INSTALL_DIR=/usr/local/bin
    curl -LsSf https://astral.sh/uv/install.sh | sh
    uv --version

    # ── dependencies ─────────────────────────────────────────────────────────
    # Needs network: nine dependencies are git-sourced from GitHub, plus PyPI
    # and download.pytorch.org. On FASRC/Kempner the compute nodes have working
    # outbound HTTPS, so use singularity/build.sbatch — a login-node build gets
    # its mksquashfs step killed by the process arbiter.
    #
    # --frozen pins those nine repos to the commits in uv.lock, which this fork
    # tracks even though upstream gitignores it. Without it every build resolves
    # them at HEAD and no two images are alike. To intentionally take newer
    # upstream commits, regenerate the lock outside the container and rebuild:
    #
    #   uv lock --upgrade && singularity build --fakeroot ...
    cd /opt/mosaic
    uv sync --frozen --group jax-cuda --python /usr/bin/python3.12

    # ── dm-haiku vs JAX 0.11 ─────────────────────────────────────────────────
    # dm-haiku 0.0.16 is the newest release and reads 15 names that JAX removed
    # in 0.11. It declares jax>=0.8.1 with no upper bound, so uv happily resolves
    # a combination that cannot work: `import haiku` raises on jax.core.DropVar,
    # and once past that the forward pass dies on
    # jax.core.get_opaque_trace_state. AF2 is unusable without a fix, and only
    # the vendored AF2 code imports haiku, so the blast radius is AF2 alone.
    #
    # 13 of the 15 moved to jax.extend.core unchanged; restoring those onto
    # jax.core is enough for AF2 to run forward AND backward (verified). The
    # remaining two — cur_sublevel, thread_local_state — have no replacement and
    # are deliberately not faked; if AF2 ever reaches them it should fail loudly
    # rather than silently do something wrong.
    #
    # This is prepended to haiku/__init__.py rather than installed as a
    # sitecustomize so it runs only when haiku is imported — no jax import cost
    # or global monkeypatching for every other python process in the container.
    # Pinning jax<0.11 instead would drag every other backend back a version.
    HAIKU_INIT=/opt/mosaic/.venv/lib/python3.12/site-packages/haiku/__init__.py
    /opt/mosaic/.venv/bin/python - "$HAIKU_INIT" <<'PYEOF'
import sys
path = sys.argv[1]
MARK = "MOSAIC JAX 0.11 COMPAT SHIM"
src = open(path).read()
if MARK not in src:
    shim = f'''# {MARK} — see singularity/mosaic.def for the rationale.
import jax.core as _mosaic_jax_core
from jax.extend import core as _mosaic_jax_extend_core
for _mosaic_name in (
    "ClosedJaxpr", "DropVar", "Jaxpr", "JaxprEqn", "Literal", "Primitive",
    "TraceTag", "Var", "get_opaque_trace_state", "jaxpr_as_fun", "primitives",
    "set_current_trace", "take_current_trace",
):
    if not hasattr(_mosaic_jax_core, _mosaic_name) and hasattr(
        _mosaic_jax_extend_core, _mosaic_name
    ):
        setattr(
            _mosaic_jax_core,
            _mosaic_name,
            getattr(_mosaic_jax_extend_core, _mosaic_name),
        )
del _mosaic_name, _mosaic_jax_core, _mosaic_jax_extend_core

'''
    open(path, "w").write(shim + src)
    print("haiku shim installed")
else:
    print("haiku shim already present")
PYEOF
    # Fail the build rather than ship an image where AF2 cannot import or run.
    /opt/mosaic/.venv/bin/python -c "
import haiku, jax.core
print('haiku import ok', haiku.__version__)
assert hasattr(jax.core, 'get_opaque_trace_state'), 'haiku shim did not take'
print('shim verified: jax.core.get_opaque_trace_state restored')
"

    # ── AbLang / AbLang2 mount points ────────────────────────────────────────
    # Both packages cache weights INSIDE their own installed package directory
    # (ablang/pretrained.py:27, ablang2/load_model.py:46) and call os.makedirs on
    # it — which is read-only here, so they fail on first use no matter what is
    # downloaded. Neither has an env var or cache_dir argument.
    #
    # Creating the directories now makes them bindable at run time:
    # os.makedirs(exist_ok=True) is a no-op on a directory that already exists,
    # and both packages then find their weight files and skip the download
    # entirely. mosaic-exec.sh binds the populated copies over these.
    for d in /opt/mosaic/.venv/lib/python3.12/site-packages/ablang/model-weights-heavy \
             /opt/mosaic/.venv/lib/python3.12/site-packages/ablang/model-weights-light \
             /opt/mosaic/.venv/lib/python3.12/site-packages/ablang2/model-weights-ablang2-paired; do
        mkdir -p "$d"
    done

    # ── runtime mount points ─────────────────────────────────────────────────
    # Only two absolute paths are needed. The weight caches are NOT mounted at
    # invented locations — mosaic-exec.sh binds them directly onto the paths
    # mosaic already looks for inside a writable HOME (~/.boltz, ~/.alphafold,
    # ~/.protenix, ~/.cache/huggingface). That removes the need to redirect
    # anything by environment variable.
    #
    # /jax_cache must exist at this exact path: examples/proteina.py:16 and
    # examples/promera_design.py:26 hardcode it as an absolute path. Inside a
    # container that is a feature, not a bug — bind scratch onto it.
    mkdir -p /jax_cache /work
    chmod 1777 /jax_cache /work

    # Make the venv usable without activation.
    ln -sf /opt/mosaic/.venv/bin/python /usr/local/bin/mosaic-python

%environment
    export PATH=/opt/mosaic/.venv/bin:$PATH
    export PYTHONUNBUFFERED=1
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8

    # Deliberately NOT setting HF_HOME / MOSAIC_MSA_CACHE /
    # MOSAIC_OPENDDE_TEMPLATE_CACHE. mosaic-exec.sh binds the shared caches
    # straight onto mosaic's own default locations inside a writable HOME, so
    # the defaults are already correct and there is nothing to redirect.
    #
    # This is also the only arrangement that works for Protenix:
    # losses/protenix.py:23 sets PROTENIX_DATA_ROOT_DIR unconditionally at
    # import, so anything exported here would be silently overwritten anyway.

    # Jobs get an exclusive GPU, so let XLA claim it. Override per-job if you
    # ever share a card (you shouldn't — mosaic is single-device throughout).
    export XLA_PYTHON_CLIENT_MEM_FRACTION=0.95

    # The FASRC hosts export RHEL CA paths (SSL_CERT_FILE / CURL_CA_BUNDLE ->
    # /etc/ssl/certs/ca-bundle.crt) that do not exist here, and Singularity
    # inherits them — every `requests` HTTPS call then dies with
    # "Could not find a suitable TLS CA certificate bundle". That breaks weight
    # downloads and the ColabFold MSA fetches Boltz/OF3/Protenix make during
    # featurization. mosaic-exec.sh also sets these via SINGULARITYENV_ (which
    # wins over inherited vars); this is the fallback for a bare
    # `singularity exec`.
    export SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
    export SSL_CERT_DIR=/etc/ssl/certs
    export CURL_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt

%runscript
    exec python "$@"

%test
    # Build-time checks only. No GPU is visible during `singularity build`,
    # so this cannot verify CUDA — it confirms the environment resolves.
    set -eu
    /opt/mosaic/.venv/bin/python /opt/mosaic/singularity/selftest.py --build
    command -v wget >/dev/null || { echo "FAIL: wget missing (boltzgen needs it)"; exit 1; }
    echo "OK: image self-test passed"

%help
    mosaic — multi-objective protein design in JAX.

    BUILD (login node, needs internet and ~40 GB free)
        cd <repo root>
        singularity build --fakeroot singularity/mosaic.sif singularity/mosaic.def

    RUN
        Use the wrapper — it assembles the bind mounts and creates the mount
        points, which have to exist before Singularity can mount onto them:

            singularity/mosaic-exec.sh python /opt/mosaic/singularity/selftest.py

        Pass --show to print the resolved command without running it. Configure
        via MOSAIC_SIF, MOSAIC_WEIGHTS and MOSAIC_SCRATCH.

    --nv is mandatory. Without it JAX silently falls back to CPU and a design
    run that should take hours takes days.

    -H is mandatory. mosaic writes model weights to five separate directories
    under $HOME; without the override you will fill your home quota. The
    wrapper binds the shared read-only caches directly onto those locations
    inside a scratch HOME, so no environment redirection is needed and no
    symlinks are involved.

    RESOURCES
        1 GPU per job — there is no pmap, sharding or jax.distributed anywhere
        in the source, so extra GPUs cannot be used. Scale with a job array.
        H100 (80 GB) is enough unless ESM-C 6B is in the objective, which costs
        24 GB of fp32 weights on its own; use H200 (141 GB) for that.
